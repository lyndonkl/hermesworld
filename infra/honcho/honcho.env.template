# Honcho stack environment for hermesworld: every LLM job on OpenRouter.
#
# Rendered by `tools/memory.sh` into ~/.honcho/profiles/hermes/.env with the
# double-brace placeholders filled from flags or defaults. Honcho reads these as
# settings (env overrides config.toml); full reference:
# https://honcho.dev/docs/v3/contributing/configuration
#
# Job routing (docs/MEMORY.md):
#   deriver, summaries, dreams        -> {{FAST_MODEL}}   (high volume, structured output)
#   dialectic minimal / low / medium  -> {{FAST_MODEL}}   (runs before each reply; must be quick)
#   dialectic high / max              -> {{DEEP_MODEL}}   (multi-step reasoning, on request)
#   embeddings                        -> {{EMBED_MODEL}} ({{EMBED_DIMS}} dimensions)
# All models must support tool calling; these do. Honcho's `openai` transport speaks to
# any OpenAI-compatible endpoint, and OpenRouter's /v1/embeddings works the same way.

LOG_LEVEL=INFO
AUTH_USE_AUTH=false
CACHE_ENABLED=true
LLM_DEFAULT_MAX_TOKENS=2000

# --- transport key: one OpenRouter key for everything -------------------------
LLM_OPENAI_API_KEY={{OPENROUTER_API_KEY}}

# --- Deriver: extracts observations, builds representations (every message) --
DERIVER_ENABLED=true
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL={{FAST_MODEL}}
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL={{BASE_URL}}
DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DERIVER_MODEL_CONFIG__MAX_OUTPUT_TOKENS=2048
DERIVER_MAX_INPUT_TOKENS=25000
DERIVER_WORKERS=1

# --- Summaries (every 20 / 60 messages) --------------------------------------
SUMMARY_ENABLED=true
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL={{FAST_MODEL}}
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL={{BASE_URL}}

# --- Dreams: background consolidation when idle --------------------------------
DREAM_ENABLED=true
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL={{FAST_MODEL}}
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL={{BASE_URL}}
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL={{FAST_MODEL}}
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL={{BASE_URL}}

# --- Dialectic: the reasoning Hermes injects before a reply --------------------
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL={{FAST_MODEL}}
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL={{BASE_URL}}
DIALECTIC_LEVELS__minimal__MAX_OUTPUT_TOKENS=600
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL={{FAST_MODEL}}
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL={{BASE_URL}}
DIALECTIC_LEVELS__low__MAX_OUTPUT_TOKENS=1200
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL={{FAST_MODEL}}
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL={{BASE_URL}}
DIALECTIC_LEVELS__medium__MAX_OUTPUT_TOKENS=2500
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL={{DEEP_MODEL}}
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL={{BASE_URL}}
DIALECTIC_LEVELS__high__MAX_OUTPUT_TOKENS=4000
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL={{DEEP_MODEL}}
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL={{BASE_URL}}
DIALECTIC_LEVELS__max__MAX_OUTPUT_TOKENS=8000
DIALECTIC_MAX_INPUT_TOKENS=100000

# --- Embeddings ----------------------------------------------------------------
EMBED_MESSAGES=true
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL={{EMBED_MODEL}}
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL={{BASE_URL}}
EMBEDDING_MODEL_CONFIG__MAX_BATCH_SIZE=64
EMBEDDING_VECTOR_DIMENSIONS={{EMBED_DIMS}}
