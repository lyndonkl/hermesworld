# Honcho local stack environment for hermesworld.
#
# Rendered by `python3 tools/memory_setup.py up` into ~/.honcho/profiles/hermes/.env,
# with the double-brace placeholders filled from flags or defaults. Honcho reads these as
# settings (env overrides config.toml); full reference:
# https://honcho.dev/docs/v3/contributing/configuration
#
# Routing (see docs/MEMORY.md): background work (deriver, summaries, dreams,
# embeddings) goes to the LOCAL model server; the per-turn dialectic reasoning,
# which the conversation waits on, goes to a cheap cloud model when an OpenRouter
# key is present, otherwise it stays local too.

LOG_LEVEL=INFO
AUTH_USE_AUTH=false
CACHE_ENABLED=true
LLM_DEFAULT_MAX_TOKENS=2000

# --- LLM transport keys ------------------------------------------------------
# Honcho refuses to start without LLM_OPENAI_API_KEY. A local vLLM server needs
# no key, so a placeholder satisfies the check.
LLM_OPENAI_API_KEY=local-no-key
LLM_OPENROUTER_API_KEY={{OPENROUTER_API_KEY}}

# --- Deriver: extracts observations, builds representations (every message) --
DERIVER_ENABLED=true
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL={{LOCAL_LLM_MODEL}}
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL={{LOCAL_LLM_BASE_URL}}
DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DERIVER_MODEL_CONFIG__THINKING_EFFORT=minimal
DERIVER_MODEL_CONFIG__MAX_OUTPUT_TOKENS=2048
DERIVER_MAX_INPUT_TOKENS=25000
DERIVER_WORKERS=1

# --- Summaries (every 20 / 60 messages) --------------------------------------
SUMMARY_ENABLED=true
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL={{LOCAL_LLM_MODEL}}
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL={{LOCAL_LLM_BASE_URL}}
SUMMARY_MODEL_CONFIG__THINKING_EFFORT=minimal

# --- Dreams: background consolidation when idle --------------------------------
DREAM_ENABLED=true
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL={{LOCAL_LLM_MODEL}}
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL={{LOCAL_LLM_BASE_URL}}
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL={{LOCAL_LLM_MODEL}}
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL={{LOCAL_LLM_BASE_URL}}

# --- Dialectic: the reasoning Hermes injects before each reply -----------------
# This runs in the request path of the conversation (Hermes prefetches it every
# couple of turns), so it needs to be FAST. On one machine a 27B reasoning model
# queued behind other jobs took minutes per call, so every level goes to the cheap
# cloud model when an OpenRouter key exists, and stays local otherwise.
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL={{DIALECTIC_MODEL}}
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL={{DIALECTIC_BASE_URL}}
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__API_KEY_ENV={{DIALECTIC_KEY_ENV}}
DIALECTIC_LEVELS__minimal__MAX_OUTPUT_TOKENS=600
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL={{DIALECTIC_MODEL}}
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL={{DIALECTIC_BASE_URL}}
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__API_KEY_ENV={{DIALECTIC_KEY_ENV}}
DIALECTIC_LEVELS__low__MAX_OUTPUT_TOKENS=1200
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL={{DIALECTIC_MODEL}}
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL={{DIALECTIC_BASE_URL}}
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__API_KEY_ENV={{DIALECTIC_KEY_ENV}}
DIALECTIC_LEVELS__medium__MAX_OUTPUT_TOKENS=2500
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL={{DIALECTIC_MODEL}}
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL={{DIALECTIC_BASE_URL}}
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__API_KEY_ENV={{DIALECTIC_KEY_ENV}}
DIALECTIC_LEVELS__high__MAX_OUTPUT_TOKENS=4000
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL={{DIALECTIC_MODEL}}
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL={{DIALECTIC_BASE_URL}}
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__API_KEY_ENV={{DIALECTIC_KEY_ENV}}
DIALECTIC_LEVELS__max__MAX_OUTPUT_TOKENS=8000
DIALECTIC_MAX_INPUT_TOKENS=100000

# --- Embeddings: served by the same local server (--embedding-model) ----------
EMBED_MESSAGES=true
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL={{LOCAL_EMBED_MODEL}}
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL={{LOCAL_LLM_BASE_URL}}
EMBEDDING_MODEL_CONFIG__MAX_BATCH_SIZE=32
EMBEDDING_VECTOR_DIMENSIONS={{LOCAL_EMBED_DIMS}}
